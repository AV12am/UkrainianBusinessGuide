# Required for fetching: identifiable user agent with a contact address
TERMWATCH_CONTACT_EMAIL=you@your-domain.example
# Optional: LLM analysis (without a key, changes are stored and analysis stays pending)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Price per million tokens in USD, used for the cost log and the budget guard
LLM_PRICE_IN_PER_MTOK=1
LLM_PRICE_OUT_PER_MTOK=5
DAILY_LLM_BUDGET_USD=5
